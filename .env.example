# URL-encode special characters in the password (* becomes %2A).
DATABASE_URL=postgresql+psycopg://querygoat:YOUR_PASSWORD_HERE@localhost:5432/querygoat
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Google OAuth (Cloud Console OAuth client — NOT your Gmail password)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# Gmail SMTP app password — used later for daily puzzle emails, not for OAuth
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Protects POST /internal/daily/run (leave empty to disable the HTTP trigger)
DAILY_JOB_SECRET=

# LLM provider — used by the agent to rewrite Spider prompts into clear puzzles
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
